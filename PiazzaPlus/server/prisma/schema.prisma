// Pijaca Plus — data model (SQLite). Enums are emulated with String fields
// because SQLite has no native enum; allowed values are documented inline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./pijaca.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  bio          String?
  // role: "KUPAC" | "PRODAVAC". A user starts as KUPAC and can become a seller.
  role         String   @default("KUPAC")
  avatarKey    String? // key into the app's bundled image map (kupac/prodavac)
  // JSON blobs for demo simplicity
  dietary      String   @default("[]") // string[] of diet keys
  allergies    String   @default("[]") // string[] of allergy keys
  settings     String   @default("{}") // settings object
  createdAt    DateTime @default(now())

  reservations  Reservation[]
  listings      Listing[]
  ownedProducts Product[]      @relation("SellerProducts")
  receipts      Receipt[]
  savedRecipes  Recipe[]
  notifications Notification[]
  donations     Donation[]
}

model Market {
  id        String    @id @default(cuid())
  name      String
  city      String
  workHours String // e.g. "07:00 - 14:00"
  imageKey  String?
  products  Product[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  price       Float // RSD per unit
  unit        String        @default("kg")
  category    String        @default("Povrće") // Voće | Povrće | Ostalo
  imageKey    String? // key into bundled images
  sellerName  String?
  seller      User?         @relation("SellerProducts", fields: [sellerId], references: [id])
  sellerId    String?
  market      Market?       @relation(fields: [marketId], references: [id])
  marketId    String?
  reservations Reservation[]
}

model Reservation {
  id        String   @id @default(cuid())
  buyer     User     @relation(fields: [buyerId], references: [id])
  buyerId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Float
  total     Float
  // status: "NA_CEKANJU" | "POTVRDJENA" | "OTKAZANA"
  status    String   @default("NA_CEKANJU")
  createdAt DateTime @default(now())
}

model Listing {
  id           String   @id @default(cuid())
  seller       User     @relation(fields: [sellerId], references: [id])
  sellerId     String
  title        String
  description  String   @default("")
  category     String   @default("Povrće")
  quantity     String   @default("")
  price        Float
  // discount: 0 = none; otherwise percentage. discountType: "NONE"|"MANUAL"|"DYNAMIC"
  discount     Float    @default(0)
  discountType String   @default("NONE")
  imageUrl     String? // uploaded image served from /uploads, or a bundled key
  imageKey     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Recipe {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  ingredients String  @default("[]") // string[]
  steps       String  @default("[]") // string[]
  imageKey    String?
  aiGenerated Boolean @default(false)
  owner       User?   @relation(fields: [ownerId], references: [id])
  ownerId     String?
}

model Receipt {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  store     String
  date      String
  total     Float
  items     String   @default("[]") // [{name, price}]
  imageKey  String?
  createdAt DateTime @default(now())
}

model Recipient {
  id        String     @id @default(cuid())
  name      String
  city      String
  logoKey   String?
  donations Donation[]
}

model Donation {
  id          String    @id @default(cuid())
  donor       User      @relation(fields: [donorId], references: [id])
  donorId     String
  recipient   Recipient @relation(fields: [recipientId], references: [id])
  recipientId String
  items       String    @default("[]") // [{name, qty}]
  estValue    Float     @default(0)
  createdAt   DateTime  @default(now())
}

model Prediction {
  id          String @id @default(cuid())
  productName String
  day         String // day of week
  // JSON array of 7 numbers (predicted surplus per day)
  series      String @default("[]")
  recommended String @default("")
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  // audience: "KUPAC" | "PRODAVAC"
  audience  String   @default("KUPAC")
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
